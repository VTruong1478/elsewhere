NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

NEXTAUTH_SECRET=
# AUTH_SECRET can be used instead of NEXTAUTH_SECRET.
# AUTH_SECRET=

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional admin/dev tooling
ELSEWHERE_ADMIN_EMAILS=
DEV_AUTH_EMAIL=
DEV_AUTH_PASSWORD=

# Optional scripts / local database helpers
# DATABASE_URL=
# DIRECT_URL=
# SUPABASE_DB_PASSWORD=
# LOCAL_SUPABASE_DATABASE_URL=

# Place-submission notification email (Supabase DB webhook -> Resend).
# Required in production — lib/env.ts throws at startup if any is missing there,
# and only warns locally. Each fails silently in its own way when unset.

# Shared secret the Supabase webhook must send as the `x-webhook-secret` HEADER.
# A query-string secret is no longer accepted (it leaks into access logs).
# Unset => every webhook delivery 401s.
SUPABASE_WEBHOOK_SECRET=
# Resend API key used to send the notification. Unset => the send throws into a
# catch and the webhook still returns 200, so the email is lost without a trace.
RESEND_API_KEY=
# Inbox that receives "new place submission" emails.
# Unset => the webhook returns 200 and skips the email entirely.
DEVELOPER_NOTIFICATION_EMAIL=
