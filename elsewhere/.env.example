NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

NEXTAUTH_SECRET=
# AUTH_SECRET can be used instead of NEXTAUTH_SECRET.
# AUTH_SECRET=

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional admin/dev tooling
ELSEWHERE_ADMIN_EMAILS=
DEV_AUTH_EMAIL=
DEV_AUTH_PASSWORD=

# Optional scripts / local database helpers
# DATABASE_URL=
# DIRECT_URL=
# SUPABASE_DB_PASSWORD=
# LOCAL_SUPABASE_DATABASE_URL=

# Optional — place-submission notification email (Supabase DB webhook -> Resend)
# SUPABASE_WEBHOOK_SECRET must be sent by the webhook as the `x-webhook-secret`
# HEADER. A query-string secret is no longer accepted (it leaks into access logs).
SUPABASE_WEBHOOK_SECRET=
RESEND_API_KEY=
DEVELOPER_NOTIFICATION_EMAIL=
